vector<ArmorPair> MyDemo：:p airLightBars（vector<LightBar> & bars） {
struct Cand { float score; size_t i， j; };
vector<Cand> cands;

对于（size_t i = 0;i < bars.size（）; i++） {
对于 （size_t j = i + 1; j < bars.size（）; j++） {
size_t a = i， b = j;
如果 （bars[a].center.x > bars[b].center.x） swap（a， b）;

float wA = bars[a].rect.size.width，hA = bars[a].rect.size.height;
float wB = bars[b].rect.size.width，hB = bars[b].rect.size.height;

float lenA = max（wA， hA）， lenB = max（wB， hB）;// 灯条长度
浮点 len = （lenA + lenB） / 2;

浮点数 widA = min（wA， hA），widB = min（wB， hB）;// 灯条宽度
float wid = max（widA， widB）;

如果 （len < 4 || wid < 2） 继续;

float dx = bars[b].center.x - bars[a].center.x;
float dy = fabs（bars[a].center.y - bars[b].center.y）;

         
如果 （fabs（lenA - lenB） / len > 0.35f） 继续;

          
如果 （fabs（widA - widB） / wid > 0.40f） 继续;

        
如果 （dy > dx） 继续;

           
如果 （dx < len * 1.0f || dx > len * 3.5f） 继续;

float score = fabs（dx / len - 2.0f） + fabs（lenA - lenB） / len;
cands.push_back（{score， a， b}）;
        }
    }

sort（cands.begin（）， cands.end（），
[]（cont Cand &x， cont Cand & y） { 返回 x.score < y.score; }）;

vector<bool> used（bars.size（）， false）;
vector<ArmorPair>对;

对于（auto &c ： cands） {
如果（used[c.i] || used[c.j]）继续;
使用[c.i] = 使用[c.j] = true;

矢量<Point2f>点;
Point2f，第4页;
bars[c.i].rect.points（p）;
